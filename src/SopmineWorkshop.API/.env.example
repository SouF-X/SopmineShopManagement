ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True
JwtSettings__Issuer=SopmineWorkshop
JwtSettings__Audience=SopmineWorkshopClient
JwtSettings__Secret=REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_SECRET
JwtSettings__TokenExpirationInMinutes=60
Cors__AllowedOrigins__0=https://your-frontend-host.example
Hosting__UseHttpsRedirection=true
Hosting__UseHsts=true
Hosting__TrustForwardedHeaders=false
DefaultAdmin__Email=admin@example.com
DefaultAdmin__Password=REPLACE_WITH_A_STRONG_PASSWORD_10_CHARS_MIN
DefaultAdmin__Role=Admin
Gemini__ApiKey=REPLACE_WITH_GEMINI_KEY
Gemini__Model=gemini-2.5-flash
Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta/models
