# Copy this file to .env and replace every REPLACE_ value before starting.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

SQL_DATABASE=SopmineShop
SQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_SQL_PASSWORD
MSSQL_PID=Express

JWT_ISSUER=SopmineShopManagement
JWT_AUDIENCE=SopmineShopManagementClient
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_SECRET
JWT_TOKEN_EXPIRATION_MINUTES=60

DEFAULT_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
DEFAULT_ADMIN_ROLE=Admin

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
